<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
        <!-- Same base as the client theme (Material 3, day and night). The server app does not
         carry the client's extensive theme and font customisations, and does not need them. -->
    <style name="Theme.TypeonServer" parent="Theme.Material3.DayNight">
        <!-- targetSdk 35 forces edge-to-edge; the layouts do not handle insets, so keep the old behaviour. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>
</resources>
