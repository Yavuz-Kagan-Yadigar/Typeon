<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 34+: dataSync foreground services are capped at 6 h a day on
         Android 15+, after which the service is demoted and (MIUI) loses the
         network in the background. remoteMessaging has no cap. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sunucunun ekran kapalıyken de teslim yapabilmesi için; kullanıcı
         onayı istenir, reddedilirse sunucu yine çalışır ama Android onu
         uyku modunda daha agresif kısıtlar. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Yeniden başlatmadan sonra sunucuyu geri getirmek için — bkz.
         server/BootReceiver.kt. Sunucu kapalıyken store-and-forward
         tamamen durduğu için bu, istemcidekinden daha kritik. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TypeonServer">

        <activity
            android:name=".ServerActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- bkz. BootReceiver — ACTION_BOOT_COMPLETED, ön plan servisi
             başlatma kısıtlarından muaf tutulan yayınlardan biri. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync|remoteMessaging" />
    </application>
</manifest>
