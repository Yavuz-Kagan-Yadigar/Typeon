<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update (service/SelfUpdate.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: later self-updates install without asking (the app is installer of record). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
        <!-- Needed to query and watch the active Wi-Fi network through ConnectivityManager. See the
         P2PService.bindToWifiIfAvailable documentation. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 34+: dataSync foreground services are capped at 6 h a day on
         Android 15+, after which the service is demoted and (MIUI) loses the
         network in the background. remoteMessaging has no cap. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Calls: without the microphone type the recorder gets silence as
         soon as the call screen is not visible (see P2PService.onStartCommand). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
        <!-- Saving to the public Downloads folder. On API 29+ this needs no permission
         (MediaStore.Downloads with scoped storage). The permission is requested and the file is
         written directly only on API 26-28, before scoped storage existed (see
         ChatActivity.saveToPublicDownloads). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
        <!-- Record audio for the press-and-hold voice message (see the ChatActivity recording
         flow). Requested at run time, on the first press-and-hold attempt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calls: speakerphone/communication mode, and the ringing screen over the lock screen. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Display over other apps": the one allowed way to open the password screen from the background, so a
         locked vault (after a reboot or a process kill) asks at once on an unlocked phone too. See Vault.showUnlockPrompt. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
        <!-- Battery optimization exemption request on first launch (see
         MainActivity.ensureBatteryOptimizationExemption). This is a normal protected
         permission: it is not requested at run time, and declaring it here is enough. The
         user's approval is taken through the ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS system
         dialog. Without this permission, that intent throws SecurityException on some devices. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        <!-- Measured on a real device: on Android 14+, the dataSync foreground service was stopped
         for 'app idle' (logcat: 'Stopping service due to app idle'). It happened in the middle
         of a 14 MB transfer, and the upload stopped silently with no error. A partial wake lock
         keeps the CPU awake while a transfer runs. It is not enough alone (see the battery
         optimization exemption button in SettingsFragment), but both are needed together. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
        <!-- Found in an audit: after a reboot the app stayed completely dead, and no messages
         arrived until the user opened it by hand. See service/BootReceiver.kt for why the
         hourly WorkManager fallback is not enough on Android 12+. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".P2PApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.P2PMessenger">

                <!-- singleTop: when the join link below is tapped while the app is already open, it
             must not stack a second MainActivity. The same instance is brought forward through
             onNewIntent. This does not change the app's own navigation: MainActivity already
             sits as the single instance at the root of the stack. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
                        <!-- Joining the server with one QR, link or text string. QR and manual paste
                 already existed; this adds a third path. The operator's published `typeon-
                 server:...#...` code becomes a clickable link in a chat or web page, and it
                 opens directly here (see MainActivity handleJoinLink). The scheme has no
                 hierarchy (no host), so `android:scheme` alone is enough. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="typeon-server" />
            </intent-filter>
                        <!-- Shown as 'Typeon' on the Android share sheet. See util.ShareIntake. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

                <!-- Keyboard compensation (see util.KeyboardInsets). adjustResize is required, but not
             for the reason it suggests. On this device (Redmi Note 8 Pro, Android 16) the
             window is NOT actually resized even when adjustResize is declared (measured with
             dumpsys window: mAttrs stays fillxfill). We already do the compensation by hand.
             Its real job here is to turn OFF the default behaviour that applies when nothing is
             declared, adjustPan. Pan shifts the whole window up, and it overlapped the padding
             we add, which broke the layout. That was the missing piece in the first attempt.
             configChanges: a rotation must not recreate the chat while the caption dialog or
             image editor is open, because the edit and the camera shot exist only there. -->
        <activity
            android:name=".ui.ChatActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.GroupChatActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.QrScanActivity" />
                <!-- Instant camera capture and crop from the chat (see ui.CameraCaptureActivity).
             configChanges: the Activity must NOT be recreated on rotation. The captured frame
             is kept in memory only, never written to disk, and recreation would lose it
             irrecoverably. -->
        <activity
            android:name=".ui.CameraCaptureActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
                <!-- App lock passcode (see ui.AppLockActivity and util.AppLock). singleTop: when the
             lock screen is already on top, a second instance must not be pushed onto the stack. -->
        <activity
            android:name=".ui.AppLockActivity"
            android:launchMode="singleTop" />
                <!-- Multi-device (spec 1.5): the screen that shows the secondary device's linking QR
             and waits for it to be accepted. -->
        <activity android:name=".ui.LinkDeviceActivity" />
        <!-- Voice/video call screen (ringing, in call). singleTask: a second
             ring notification tap must reuse the screen, not stack another. -->
        <activity
            android:name=".ui.CallActivity"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
                <!-- Pending messages list, opened from Settings. See PendingMessagesActivity and lib.rs
             list_pending_messages / cancel_pending_message. -->
        <activity android:name=".ui.PendingMessagesActivity" />
        <!-- Settings → Storage. -->
        <activity android:name=".ui.StorageActivity" />
                <!-- Simple in-app viewer for photo and video attachments, at full size and quality. See
             the note on ChatActivity.onAttachmentClicked. Previously these always went to the
             system default app. -->
        <activity
            android:name=".ui.MediaViewerActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.P2PMessenger" />

                <!-- See BootReceiver. ACTION_BOOT_COMPLETED is one of the broadcasts exempt from the
             foreground-service start restrictions. `permission`: the sender must hold
             RECEIVE_BOOT_COMPLETED. The system already enforces this, and now an app that only
             meant to start P2PService cannot inject a fake BOOT_COMPLETED broadcast either. -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".service.UpdateReceiver" android:exported="false" />
        <receiver android:name=".service.DozeWakeReceiver" android:exported="false" />

        <service
            android:name=".service.P2PService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|remoteMessaging|microphone" />

                <!-- Decrypted (plaintext) attachment copies for files, photos, videos and audio. They
             are served to system viewers as content:// URIs, without leaving the app's private
             storage. This is a privacy-first choice. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Per-app language (English/Turkish, see SettingsFragment): lets
             AppCompatDelegate.setApplicationLocales persist and re-apply
             the chosen locale automatically across restarts. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        </application>
    </manifest>
