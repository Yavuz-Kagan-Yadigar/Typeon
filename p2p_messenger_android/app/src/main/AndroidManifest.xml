<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Spec dışı: "İndirilenler/P2P"ye kaydetme akışı — API 29+'ta
         MediaStore.Downloads scoped storage üzerinden hiçbir izin
         gerektirmez; SADECE API 26-28'de (scoped storage öncesi) elle
         izin istenip doğrudan dosya yazımı için kullanılır (bkz.
         ChatActivity.saveToPublicDownloads). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Spec dışı: basılı tut/kaydet sesli mesaj özelliği (bkz.
         ChatActivity ses kaydı akışı) — çalışma zamanında (ilk basılı
         tutma denemesinde) istenir. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".P2PApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.P2PMessenger">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.ChatActivity" />
        <activity android:name=".ui.GroupChatActivity" />
        <activity android:name=".ui.QrScanActivity" />
        <!-- Spec dışı: foto/video ekleri için basit, tam boyut/kalitede
             uygulama içi görüntüleyici — bkz. ChatActivity.onAttachmentClicked
             notu (önceden HER zaman sistem varsayılan uygulamasına
             devrediliyordu). -->
        <activity
            android:name=".ui.MediaViewerActivity"
            android:theme="@style/Theme.P2PMessenger" />

        <service
            android:name=".service.P2PService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Spec dışı: dosya/foto/video/ses ekleri (bkz. ChatActivity
             openAttachmentFile) — çözülmüş (plaintext) ek kopyalarını
             sistem görüntüleyicilerine content:// URI olarak, uygulamanın
             kendi dosya sisteminden çıkmadan (app-private storage, spec
             dışı gizlilik-öncelikli tercih) sunmak için gerekli. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        </application>
    </manifest>
