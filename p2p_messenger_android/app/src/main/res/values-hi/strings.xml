    <string name="lbl_relay_address">ज्ञात रिले पता</string>
    <string name="lbl_relay_address_desc">यह तभी चाहिए जब अलग-अलग नेटवर्क पर दो लोग पहली बार जुड़ें। किसी भरोसेमंद डिवाइस का पता यहाँ चिपकाएँ, जिस पर नोड मोड चालू हो, या अपना पता।</string>
