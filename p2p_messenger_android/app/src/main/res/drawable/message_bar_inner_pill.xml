<?xml version="1.0" encoding="utf-8"?>
<!-- Thin frames inside the outer pill (see message_bar_pill.xml), separating the button group
     and the text field. No fill, only outlines. Otherwise a second solid surface would sit on
     top of the outer pill and look heavy and two-layered. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
</shape>
