<?xml version="1.0" encoding="utf-8"?>
<!-- Send button icon. It is now the app's own cloud and rain logo, not a generic arrow, drawn
     from the reference image. The shape is deliberately a single-colour silhouette (no fill,
     only rounded-end outlines) with colour @android:color/white. The real colour comes from the
     tint applied on top (see activity_chat.xml btnSend android:tint). So the same file draws
     correctly in light and dark themes and in the chosen accent colour, and no separate variant
     file is needed. viewport 470x530 (not square): the logo is vertical, and the rain lines
     extend below the cloud. The width/height ratio matches that, otherwise the icon was
     squashed horizontally. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="27dp"
    android:viewportWidth="470"
    android:viewportHeight="530"
    android:tint="?attr/colorOnPrimary">

        <!-- Cloud: the bottom edge is NOT closed (as in the reference). It is one open curve ending
         in two rounded caps. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="35"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M152,256 C128,268 92,266 66,244 C30,214 22,156 50,118 C76,82 128,74 158,98 C172,46 222,14 274,22 C330,30 372,76 374,128 C414,132 444,168 436,210 C428,250 392,272 352,262" />

        <!-- Rain: three vertical lines. The middle one is the longest and starts highest. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="35"
        android:strokeLineCap="round"
        android:pathData="M231,175 L231,505" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="35"
        android:strokeLineCap="round"
        android:pathData="M168,305 L168,505" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="35"
        android:strokeLineCap="round"
        android:pathData="M291,262 L291,505" />

</vector>
