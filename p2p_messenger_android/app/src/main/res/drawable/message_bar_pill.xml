<?xml version="1.0" encoding="utf-8"?>
<!-- The chat bottom bar (attach, camera and voice buttons, text field, send) is now inside ONE
     pill. The radius is kept larger than half the height of one line, so the edges stay round
     even when several lines are typed (Android shortens the radius automatically). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/colorSurfaceVariant" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
</shape>
