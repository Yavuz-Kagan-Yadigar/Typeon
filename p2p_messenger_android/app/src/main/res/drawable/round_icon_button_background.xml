<?xml version="1.0" encoding="utf-8"?>
<!-- Circular background of the attach and voice buttons (see the note on activity_chat.xml
     btnAttach and btnVoice). Previously they had only a borderless ripple and no fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorOnSurfaceVariant">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>
</ripple>
