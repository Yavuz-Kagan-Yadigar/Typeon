<?xml version="1.0" encoding="utf-8"?>
<!-- Consecutive messages from the same sender, less than 2 minutes apart, read as ONE stack.
     This is done by reducing the corner radius on the edge where the bubbles join (the fused-
     block look of the reference design). This is the variant of bubble_mine for group members
     that are not the first: the right spine is also joined at the top, so the top-right corner
     is small too. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/colorPrimaryContainer" />
    <corners
        android:topLeftRadius="18dp"
        android:topRightRadius="4dp"
        android:bottomLeftRadius="18dp"
        android:bottomRightRadius="4dp" />
</shape>
