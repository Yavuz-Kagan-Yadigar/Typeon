<?xml version="1.0" encoding="utf-8"?>
<!-- Emoji reactions on a message appear in their OWN pill beside the first line of the bubble,
     not inside it (WhatsApp pattern). The background is independent of the bubble, because it
     sits on the chat background: colorSurfaceVariant plus a thin outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/colorSurfaceVariant" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
</shape>
