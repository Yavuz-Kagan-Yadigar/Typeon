<?xml version="1.0" encoding="utf-8"?>
<!-- Spec dışı, kullanıcı isteği: bir mesaja bırakılan emojiler, balonun
     İÇİNDE değil, ilk satırının yanında AYRI bir pill içinde görünür
     (WhatsApp deseni). Zemin balondan bağımsız — sohbet arka planının
     üzerinde durduğu için `colorSurfaceVariant` + ince kontur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/colorSurfaceVariant" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
</shape>
