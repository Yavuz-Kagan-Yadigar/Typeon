<?xml version="1.0" encoding="utf-8"?>
<!-- Security-audit fix (allowBackup): for a secure messaging app, no app data goes into any
     backup (cloud auto-backup, adb backup, device transfer). Some data on disk is decrypted
     plaintext (attachments/plain_cache/, libp2p_identity.key) and sensitive metadata (SQLite:
     contact IDs, group membership, file names), and it should not leave the device. Secret key
     blobs are already wrapped with the Android Keystore. Keystore keys are bound to the device
     and cannot be exported, so they would be useless on another device even in a backup. The
     full exclusion is applied anyway. API 31+ uses this file. For API 26-30,
     fullBackupContent="false" and allowBackup="false" in the manifest apply. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
