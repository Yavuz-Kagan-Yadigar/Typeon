<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
        <!-- Context.getFilesDir()/attachments/plain_cache/. See
         P2PCore::get_attachment_plaintext_path (lib.rs). Only this subdirectory is shared.
         Encrypted .enc files and the database are never reachable through the FileProvider. -->
    <files-path name="attachment_plain_cache" path="attachments/plain_cache/" />
        <!-- Context.getCacheDir()/avatar_view/. See AvatarUtil.openFullscreen: a profile or group
         photo is written here temporarily while it is passed to the full-screen viewer
         (MediaViewerActivity). Only this subdirectory is shared. -->
    <cache-path name="avatar_view" path="avatar_view/" />
    <!-- Context.getCacheDir()/attachment_preview/ — util.AttachmentPrompt:
         the camera shot or a JPEG XL (as GIF) shown full screen from the
         caption dialog; deleted when the dialog closes. -->
    <cache-path name="attachment_preview" path="attachment_preview/" />
    <!-- Context.getCacheDir()/attachment_edit/ — util.AttachmentPrompt: an
         image edited from the caption dialog, sent through this URI. -->
    <cache-path name="attachment_edit" path="attachment_edit/" />
</paths>
