<?xml version="1.0" encoding="utf-8"?>
<!-- Spec dışı, kullanıcı isteği: uygulama açılış şifresi — bkz.
     ui.AppLockActivity / util.AppLock. TEK bir düzen iki modu da taşır
     (şifre oluşturma / şifre girme); fark yalnızca başlık, açıklama ve
     `edt_app_lock_confirm`ın görünürlüğü. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:src="@mipmap/icon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txt_app_lock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/txt_app_lock_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="13sp"
            android:alpha="0.8" />

        <EditText
            android:id="@+id/edt_app_lock_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/message_input_background"
            android:padding="14dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:hint="@string/hint_app_lock_password"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edt_app_lock_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/message_input_background"
            android:padding="14dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:hint="@string/hint_app_lock_password_confirm"
            android:importantForAutofill="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_app_lock_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_app_lock_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>
