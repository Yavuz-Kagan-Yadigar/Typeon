<?xml version="1.0" encoding="utf-8"?>
<!-- Chat title: the profile photo also shows in the top bar. It is attached with
     ActionBar.setCustomView (see ChatActivity and GroupChatActivity onCreate), so it can carry
     an avatar, unlike the default ActionBar title. The device's own connection status
     (txtOwnConnectionStatus) is at the far right of the top bar, not below the name. For that,
     the root width must be match_parent: ChatActivity and GroupChatActivity pass
     ActionBar.LayoutParams with MATCH_PARENT explicitly, otherwise the custom view wraps its
     content and 'far right' never reaches the real edge. The title and subtitle block takes all
     remaining space with weight=1, so a long title or subtitle is cut inside itself
     (ellipsize). It never pushes the status text off-screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgToolbarAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <!-- The peer's connection status is also shown as a small coloured dot beside the plain
             text (see ChatActivity dotPeerStatus and updatePeerStatusDot), so 'connected',
             'connecting' and 'not connected' can be told apart at a glance. In group chat the
             whole row is hidden, because there is no single peer or handshake concept (see
             GroupChatActivity, which hides this row rather than txtToolbarSubtitle). -->
        <LinearLayout
            android:id="@+id/layoutToolbarSubtitleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotPeerStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/txtToolbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:alpha="0.8"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

        <!-- This device's own connection status (Tor, node, internet), not the peer's (see
         txtToolbarSubtitle). See ChatActivity and GroupChatActivity ownStatusPollRunnable. It
         sits at the far right of the top bar and stays fixed, so it does not jump while the
         title block grows and shrinks. The peer status and this device's status use the same
         coloured dot and pulse pattern (see dotPeerStatus and util.PulsingStatusDot). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dotOwnStatus"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/txtOwnConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:alpha="0.7"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
