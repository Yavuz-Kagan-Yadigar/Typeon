<?xml version="1.0" encoding="utf-8"?>
<!-- The page must scroll, because the QR code is large and the content may not fit the screen.
     The root is now a NestedScrollView. The RecyclerView sits inside it with
     nestedScrollingEnabled=false and wrap_content: it shows all contacts, and the outer scroll
     does the scrolling (the contact list is small, so losing recycling does not matter). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_contacts"
            android:textSize="24sp"
            android:textStyle="bold"/>

                <!-- Our own QR code appears directly on this tab. Its size is not hardcoded:
             ContactsFragment sets it to 75% of the screen width (see sizeOwnQr). -->
        <ImageView
            android:id="@+id/imgOwnQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_show_qr" />

        <TextView
            android:id="@+id/txtOwnIdentityCode"
            android:textDirection="ltr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

                <!-- Copy to clipboard, for when the QR code cannot be scanned. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_copy_manual_code"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_copy_manual_code"/>
            <Button
                android:id="@+id/btn_copy_own_address"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_copy_own_address"/>

        </LinearLayout>

                <!-- Other pairing methods: just below the QR, centred. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_scan_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_add_contact_qr"/>
            <Button
                android:id="@+id/btn_manual_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/title_add_manually"/>

        </LinearLayout>

        <TextView
            android:id="@+id/contactsPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:alpha="0.6"
            android:text="@string/msg_no_contacts"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"/>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
