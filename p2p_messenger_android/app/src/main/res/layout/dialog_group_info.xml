<?xml version="1.0" encoding="utf-8"?>
<!-- Opened by tapping the top bar of GroupChatActivity: the group profile photo (only the
     founder can change it), the member list, and (for the founder) adding members, all in one
     place. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgGroupAvatarLarge"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null" />

                <!-- Only the founder sees this. -->
        <LinearLayout
            android:id="@+id/rowAvatarActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnChangeGroupPicture"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_change_picture" />

            <Button
                android:id="@+id/btnRemoveGroupPicture"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_remove_picture" />

        </LinearLayout>

                <!-- Same as the 1:1 menu in the chat screen: this group's local attachments (see
             GroupChatActivity.showGroupInfoDialog). -->
        <Button
            android:id="@+id/btnGroupFilesMedia"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/action_files_media" />

                <!-- For the founder the heading is 'Manage members' (not just 'Add member'). For other
             members it shows the current member count. -->
        <TextView
            android:id="@+id/txtGroupMemberCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

                <!-- 'Add member' is now at the very top, above the list. Only the founder sees it. -->
        <Button
            android:id="@+id/btnAddMemberToGroup"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lbl_add_member_to_group"
            android:visibility="gone" />

                <!-- Each member's name, plus a confirmed removal button (only for the founder, and not
             on the founder's own row). See GroupChatActivity.showGroupInfoDialog and
             item_group_member.xml. -->
        <LinearLayout
            android:id="@+id/layoutMembersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
