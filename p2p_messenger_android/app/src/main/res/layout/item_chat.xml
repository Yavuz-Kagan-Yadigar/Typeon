<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/content_desc_profile_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- The gap has to live here (marginStart), not as imgAvatar's
         marginEnd: ConstraintLayout only applies a margin on a side that
         view itself has a constraint on, and imgAvatar has no end
         constraint (fixed width instead), so marginEnd on it is a no-op. -->
    <TextView
        android:id="@+id/txtContactName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/txtUnreadCount"
        app:layout_constraintStart_toEndOf="@id/imgAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toStartOf="@id/txtTimestamp"
        app:layout_constraintStart_toEndOf="@id/imgAvatar"
        app:layout_constraintTop_toBottomOf="@id/txtContactName" />

    <TextView
        android:id="@+id/txtTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/txtUnreadCount"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Zemin `colorSurfaceVariant` (bkz. message_input_background); metin de
         onun eşi olan `colorOnSurfaceVariant` olmalı. Sabit `@android:color/white`,
         AÇIK temada açık gri zeminin üzerinde neredeyse okunmuyordu —
         kullanıcının bildirdiği alıntı kutusu hatasıyla aynı sınıf: tek bir
         temada çalışan sabit renk. -->
    <TextView
        android:id="@+id/txtUnreadCount"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/message_input_background"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
