<?xml version="1.0" encoding="utf-8"?>
<!-- Spec dışı, kullanıcı isteği: henüz karşı taraftan "ack" alınmamış
     (bkz. lib.rs awaiting_confirmation/regen_content) mesajların listesi —
     her satırda son deneme zamanı + İptal düğmesi (bkz.
     PendingMessagesActivity/PendingMessagesAdapter). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/txtNoPendingMessages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="@string/msg_no_pending_messages"
        android:textAlignment="center"
        android:alpha="0.7"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPendingMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
