<?xml version="1.0" encoding="utf-8"?>
<!-- Spec dışı, kullanıcı isteği: sohbetten doğrudan anlık çekim + kırpma
     (bkz. ui.CameraCaptureActivity). TEK düzen iki aşamayı da taşır —
     "çekim" (kamera önizlemesi + deklanşör) ve "kırpma" (bkz.
     ui.CropOverlayView) — aralarında yalnızca görünürlük değişir, ayrı bir
     Activity/Fragment geçişi YOK (fotoğraf bellekte duruyor, bkz.
     util.CapturedImage). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barrierCaptureControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.p2p.messenger.ui.CropOverlayView
        android:id="@+id/cropOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barrierCaptureControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- İki kontrol satırından hangisi görünürse alt sınırı O belirlesin
         (biri her zaman GONE). -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierCaptureControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="rowCaptureControls,rowCropControls" />

    <LinearLayout
        android:id="@+id/rowCaptureControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnCloseCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white"
            android:contentDescription="@android:string/cancel" />

        <ImageButton
            android:id="@+id/btnShutter"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:padding="18dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_camera"
            app:tint="@android:color/white"
            android:contentDescription="@string/action_capture_photo" />

        <ImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tor_reconnect"
            app:tint="@android:color/white"
            android:contentDescription="@string/action_flip_camera" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowCropControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnRetake"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_retake_photo"
            android:textColor="@android:color/white"
            app:strokeColor="@android:color/white" />

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tor_reconnect"
            app:tint="@android:color/white"
            android:contentDescription="@string/action_rotate_photo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnUsePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_send" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
