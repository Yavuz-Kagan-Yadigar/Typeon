<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the 'Manage members' list in the group info dialog. See
     GroupChatActivity.showGroupInfoDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/imgMemberAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/txtMemberName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end" />

        <!-- Only the founder sees this, and not on their own row. See the Kotlin side's confirmed
         removal dialog. -->
    <Button
        android:id="@+id/btnRemoveMember"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/action_remove_member"
        android:visibility="gone" />

</LinearLayout>
