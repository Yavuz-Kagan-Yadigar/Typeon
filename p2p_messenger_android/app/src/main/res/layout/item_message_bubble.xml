<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Sadece grup sohbetinde, kendi mesajlarımız DIŞINDA gösterilir
         (bir grupta birden fazla gönderici olabileceğinden). -->
    <LinearLayout
        android:id="@+id/rowSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSenderAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği (WhatsApp tarzı "yanıtla"): bu mesaj
         başka bir mesaja yanıtsa (bkz. SimpleChatAdapter.Item.replyToMessageId)
         yanıtlanan mesajın küçük bir özeti burada gösterilir — dokununca
         (bkz. ChatActivity/GroupChatActivity onReplyPreviewClick) sohbet o
         mesaja kaydırılır. -->
    <LinearLayout
        android:id="@+id/layoutReplyQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/reply_quote_background"
        android:visibility="gone">

        <!-- Rengi kodda balonun metin rengine göre veriliyor (bkz.
             SimpleChatAdapter `bindReplyQuote`) — `?attr/colorPrimary`
             turuncu giden balonun üzerinde turuncu kalıyordu, yani
             görünmüyordu. -->
        <View
            android:id="@+id/viewReplyQuoteBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReplyQuoteSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtReplyQuoteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği: gönderilme saati ve "iletildi/okundu"
         tikleri artık balonun ALTINDA değil, İÇİNDE (WhatsApp/Telegram
         deseni). Bu yüzden balon arka planı (bkz. SimpleChatAdapter
         `bubbleBackground`) ARTIK `txtBubbleText`/`layoutAttachment`'a
         DEĞİL, ikisini de meta satırıyla birlikte saran BU kapsayıcıya
         uygulanıyor — tek bir arka plan, üç ayrı parça yerine.
         `wrap_content` + üstteki `container`ın gravity'si (END/START)
         balonun hangi kenara yaslanacağını belirlemeye devam ediyor. -->
    <!-- Spec dışı, kullanıcı isteği: "görüldü ve ulaştı tiklerini mesaj
         balonunun YANINA, ekran kenarıyla arasına taşı". Bu yüzden balon
         artık tek başına değil, yatay bir satırın içinde: [balon][yan
         sütun]. Üstteki `container`ın gravity'si (END/START) satırın
         tamamını hizaladığı için, KENDİ mesajlarımızda yan sütun balonla
         ekranın sağ kenarı ARASINDA kalıyor — istenen tam olarak bu. -->
    <LinearLayout
        android:id="@+id/rowBubbleLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="5dp">

    <TextView
        android:id="@+id/txtBubbleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="340dp"
        android:textSize="16sp" />

    <!-- Spec dışı: dosya/foto/video/ses eki balonu — `item.attachment`
         doluysa `txtBubbleText` yerine bu gösterilir (bkz.
         SimpleChatAdapter.onBindViewHolder). Tek, esnek bir düzen (dört
         ayrı görünüm tipi yerine) — küçük resim önizlemesi SADECE
         image/video MIME'lerinde görünür, diğerlerinde jenerik dosya
         simgesi + ad/boyut satırı yeterli. -->
    <LinearLayout
        android:id="@+id/layoutAttachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Spec dışı, kullanıcı isteği (WhatsApp tarzı çıkartmalar): bir
             çıkartma balonu — çerçevesiz, köşeleri hafif yuvarlatılmış
             (bkz. SimpleChatAdapter.bindSticker). -->
        <ImageView
            android:id="@+id/imgSticker"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- Spec dışı, kullanıcı isteği: gönderilen resim/videolar sohbette
             yuvarlatılmış köşeli ve ince kenarlıklı görünsün. Düz bir
             `ImageView` bunu yapamaz (kırpma yok, kenarlık yok);
             `ShapeableImageView` ikisini de tek bileşende veriyor ve
             `centerCrop` davranışı aynen korunuyor. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAttachmentThumbnail"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="6dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.P2PMessenger.Attachment"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:id="@+id/rowGenericAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgAttachmentIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_attachment_file"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAttachmentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAttachmentSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAttachmentDownload"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/lbl_download"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Spec dışı, kullanıcı isteği: indirme için GERÇEK bir ilerleme
             ÇUBUĞU (önceden satır içinde 24dp'lik küçük bir dairesel
             göstergeydi) + kalan süre (ETA) sayacı. Belirlenimli:
             bytesDone/totalSize'ı yansıtır (bkz.
             SimpleChatAdapter.bindAttachment). -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtAttachmentEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- Spec dışı: sesli mesaj balonu — jenerik dosya satırının YERİNE
             (bkz. SimpleChatAdapter.bindVoiceMessage), mime "audio/" ile
             başladığında. -->
        <LinearLayout
            android:id="@+id/layoutVoiceMessage"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnVoicePlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/round_icon_button_background"
                android:src="@drawable/ic_play"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Spec dışı, Material You: hem indirme ilerlemesi hem
                     (indirme tamamlandıktan sonra) çalma konumu için AYNI
                     kaydırıcı kullanılır — dokunup sürükleyerek (touch-to-
                     seek) konumu değiştirmek için `LinearProgressIndicator`
                     YERİNE `Slider` kullanılıyor (Material progress
                     göstergeleri kasıtlı olarak etkileşimsizdir, bu yüzden
                     eski çubukta sürükleme hiç çalışmıyordu). -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/progressVoicePlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:layout_marginEnd="-8dp"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:value="0"
                    app:thumbRadius="7dp"
                    app:trackHeight="4dp"
                    app:labelBehavior="gone" />

                <TextView
                    android:id="@+id/txtVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Spec dışı: hız kontrolü — dokununca 1x/1.5x/2x/0.5x
                 arasında döner (bkz. ChatActivity/PlaybackSpeedMenu). En az
                 40dp dokunma hedefi için padding'i büyütüldü. -->
            <TextView
                android:id="@+id/btnVoiceSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="1x"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

        <!-- Spec dışı, kullanıcı isteği: ek gönderirken "altına bir yazı
             yazılabilmeli". Açıklama, ekin ALTINDA ve balonun İÇİNDE —
             `txtBubbleText` kullanılamazdı, o düzende ekin ÜSTÜNDE duruyor
             ve metin mesajları için ayrılmış. -->
        <TextView
            android:id="@+id/txtAttachmentCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="340dp"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- bkz. `layoutBubble` notu — düzenlendi etiketi + saat + durum
             tiki artık balonun İÇİNDE, sağ alt köşesinde. Renkleri kodda
             balonun KENDİ metin rengine göre veriliyor (bkz.
             SimpleChatAdapter `onColor`): sabit `?attr/colorOnSurfaceVariant`
             gelen balonda doğruydu ama giden balonun (accent renkli)
             üzerinde okunmuyordu. -->
        <LinearLayout
            android:id="@+id/rowBubbleMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtEditedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/lbl_edited"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

        <!-- Yan sütun: tepkiler + durum tiki + "gören" avatarları. `top`
             hizası, kullanıcının "bırakılan emojiler mesajın İLK SATIRININ
             yanında görünsün" isteği için — çok satırlı bir balonda pill
             aşağı kaymaz. -->
        <LinearLayout
            android:id="@+id/colBubbleSide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="top">

            <!-- Emoji tepkileri (bkz. SimpleChatAdapter.bindReactions) —
                 sayı 1'den büyükse emojinin yanında adet de yazar. -->
            <TextView
                android:id="@+id/pillReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/reaction_pill_background"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:visibility="gone"
                android:contentDescription="@null" />

        <!-- Spec dışı, kullanıcı isteği: "görüldü" bildirimi — SADECE en son
             görülen mesajın altında (bkz. SimpleChatAdapter.applySeen, tüm
             önceki mesajlar örtük olarak görülmüş sayılır). Hem 1:1 (tek
             avatar) hem grup (birden fazla görenin avatarı) için aynı satır —
             gruplarda 3'ten fazla goren "+N" ile özetlenir. -->
        <LinearLayout
            android:id="@+id/rowSeenBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgSeenBy1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/msg_read" />

            <ImageView
                android:id="@+id/imgSeenBy2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgSeenBy3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtSeenByMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
