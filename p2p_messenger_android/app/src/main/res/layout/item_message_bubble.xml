<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

        <!-- Shown only in group chat, and not on our own messages (a group can have several
         senders). -->
    <LinearLayout
        android:id="@+id/rowSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSenderAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

        <!-- Reply preview. If this message replies to another message (see
         SimpleChatAdapter.Item.replyToMessageId), a small summary of the replied-to message is
         shown here. Tapping it (see onReplyPreviewClick in ChatActivity and GroupChatActivity)
         scrolls the chat to that message. -->
    <LinearLayout
        android:id="@+id/layoutReplyQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/reply_quote_background"
        android:visibility="gone">

                <!-- The colour is set in code from the bubble's text colour (see SimpleChatAdapter
             bindReplyQuote). ?attr/colorPrimary stayed orange on the orange outgoing bubble, so
             it was invisible. -->
        <View
            android:id="@+id/viewReplyQuoteBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReplyQuoteSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtReplyQuoteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

        <!-- Send time and the forwarded and read ticks are now inside the bubble, not below it
         (WhatsApp and Telegram pattern). So the bubble background (see SimpleChatAdapter
         bubbleBackground) is applied to THIS container, which wraps the text, the attachment
         and the meta row together: one background instead of three separate pieces.
         wrap_content plus the container's gravity (END or START) still decide which edge the
         bubble sits against. -->
        <!-- Time, read ticks and send status moved out of the bubble to a side column. The bubble
         now sits in a horizontal row: [bubble][side column]. Because the outer container's
         gravity (END or START) aligns the whole row, on our own messages the side column sits
         between the bubble and the right edge of the screen. That is the intended layout. -->
    <LinearLayout
        android:id="@+id/rowBubbleLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="5dp">

    <!-- "Forwarded" (see util.Forward), WhatsApp pattern. -->
    <TextView
        android:id="@+id/txtForwarded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_forwarded"
        android:textSize="12sp"
        android:textStyle="italic"
        android:alpha="0.7"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtBubbleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="340dp"
        android:textSize="16sp" />

    <!-- Disappearing message: time left, accent bold (SimpleChatAdapter.bindDisappear). -->
    <TextView
        android:id="@+id/txtExpire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

        <!-- Attachment bubble for a file, photo, video or audio. If item.attachment is set, this is
         shown instead of txtBubbleText (see SimpleChatAdapter.onBindViewHolder). One flexible
         layout, instead of four separate view types. The small image preview appears only for
         image and video MIME types. Other files show a generic file icon with a name and size
         line. -->
    <LinearLayout
        android:id="@+id/layoutAttachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Sticker, frameless (SimpleChatAdapter.bindSticker). -->
        <ImageView
            android:id="@+id/imgSticker"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

                <!-- Sent images and videos look rounded and have a thin border in the chat. A plain
             ImageView cannot do this (no clipping, no border). ShapeableImageView provides both
             in one component, and centerCrop behaviour is kept as it was. -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAttachmentThumbnail"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="6dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.P2PMessenger.Attachment"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:id="@+id/rowGenericAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgAttachmentIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_attachment_file"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAttachmentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAttachmentSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAttachmentDownload"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/lbl_download"
                android:visibility="gone" />

        </LinearLayout>

                <!-- A real progress bar for downloads (previously a small 24dp circular indicator
             inline), plus an ETA countdown. It is determinate: it reflects bytesDone and
             totalSize (see SimpleChatAdapter.bindAttachment). -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtAttachmentEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

                <!-- Voice message bubble: it replaces the generic file row (see
             SimpleChatAdapter.bindVoiceMessage) when the MIME type starts with audio/. -->
        <LinearLayout
            android:id="@+id/layoutVoiceMessage"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnVoicePlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/round_icon_button_background"
                android:src="@drawable/ic_play"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                                <!-- Material You: the same slider is used both for download progress and for
                     the playback position after the download completes. A Slider replaces
                     LinearProgressIndicator so the user can drag to change position (touch-to-
                     seek). Material progress indicators are intentionally non-interactive, so
                     dragging on the old bar never worked. -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/progressVoicePlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:layout_marginEnd="-8dp"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:value="0"
                    app:thumbRadius="7dp"
                    app:trackHeight="4dp"
                    app:labelBehavior="gone" />

                <TextView
                    android:id="@+id/txtVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

                        <!-- Speed control: tapping it cycles through 1x, 1.5x, 2x and 0.5x (see
                 ChatActivity and PlaybackSpeedMenu). The padding was enlarged to give a touch
                 target of at least 40dp. -->
            <TextView
                android:id="@+id/btnVoiceSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="1x"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

                <!-- When sending a file, a caption can be written under it. The caption is below the
             attachment and inside the bubble. txtBubbleText could not be used, since in that
             layout it sits above the attachment and is reserved for text messages. -->
        <TextView
            android:id="@+id/txtAttachmentCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="340dp"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:visibility="gone" />

                <!-- See the layoutBubble note. The edited label, time and status tick are now inside
             the bubble, at the bottom right. Their colours are set in code from the bubble's
             own text colour (see SimpleChatAdapter onColor). The fixed
             ?attr/colorOnSurfaceVariant was right for an incoming bubble, but not readable on
             the outgoing bubble, which is accent coloured. -->
        <LinearLayout
            android:id="@+id/rowBubbleMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtEditedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/lbl_edited"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

                <!-- Side column: reactions, the pending or error mark, and the avatars of those who
             have seen the message. It sits beside the bubble: on the right of an incoming
             bubble, and on the left of our own (see SimpleChatAdapter.placeSideColumn). top
             alignment is for the requirement that emoji reactions show next to the first line
             of the message. On a multi-line bubble the pill does not drift down. -->
        <LinearLayout
            android:id="@+id/colBubbleSide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="top">

                        <!-- Emoji reactions (see SimpleChatAdapter.bindReactions). If the count is above 1,
                 the number is written next to the emoji. -->
            <TextView
                android:id="@+id/pillReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/reaction_pill_background"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="3dp"
                android:visibility="gone"
                android:contentDescription="@null" />

                <!-- Seen indicator: shown only below the most recent seen message (see
             SimpleChatAdapter.applySeen; all earlier messages count as seen implicitly). The
             same row serves 1:1 (one avatar) and groups (the avatars of several viewers). In
             groups, only the 5 latest viewers show; the rest is +N. A tap lists who saw it, when. -->
        <LinearLayout
            android:id="@+id/rowSeenBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgSeenBy1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/msg_read" />

            <ImageView
                android:id="@+id/imgSeenBy2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgSeenBy3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgSeenBy4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgSeenBy5"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtSeenByMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
