<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Sadece grup sohbetinde, kendi mesajlarımız DIŞINDA gösterilir
         (bir grupta birden fazla gönderici olabileceğinden). -->
    <LinearLayout
        android:id="@+id/rowSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSenderAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtBubbleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="340dp"
        android:padding="12dp"
        android:textSize="22sp" />

    <!-- Spec dışı: dosya/foto/video/ses eki balonu — `item.attachment`
         doluysa `txtBubbleText` yerine bu gösterilir (bkz.
         SimpleChatAdapter.onBindViewHolder). Tek, esnek bir düzen (dört
         ayrı görünüm tipi yerine) — küçük resim önizlemesi SADECE
         image/video MIME'lerinde görünür, diğerlerinde jenerik dosya
         simgesi + ad/boyut satırı yeterli. -->
    <LinearLayout
        android:id="@+id/layoutAttachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgAttachmentThumbnail"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="6dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/rowGenericAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgAttachmentIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_attachment_file"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAttachmentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAttachmentSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <Button
                android:id="@+id/btnAttachmentDownload"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/lbl_download"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Spec dışı, kullanıcı isteği: indirme için GERÇEK bir ilerleme
             ÇUBUĞU (önceden satır içinde 24dp'lik küçük bir dairesel
             göstergeydi) + kalan süre (ETA) sayacı. Belirlenimli:
             bytesDone/totalSize'ı yansıtır (bkz.
             SimpleChatAdapter.bindAttachment). -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtAttachmentEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- Spec dışı: sesli mesaj balonu — jenerik dosya satırının YERİNE
             (bkz. SimpleChatAdapter.bindVoiceMessage), mime "audio/" ile
             başladığında. -->
        <LinearLayout
            android:id="@+id/layoutVoiceMessage"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnVoicePlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/round_icon_button_background"
                android:src="@drawable/ic_play"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Spec dışı, Material You: hem indirme ilerlemesi hem
                     (indirme tamamlandıktan sonra) çalma konumu için AYNI
                     kaydırıcı kullanılır — dokunup sürükleyerek (touch-to-
                     seek) konumu değiştirmek için `LinearProgressIndicator`
                     YERİNE `Slider` kullanılıyor (Material progress
                     göstergeleri kasıtlı olarak etkileşimsizdir, bu yüzden
                     eski çubukta sürükleme hiç çalışmıyordu). -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/progressVoicePlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:layout_marginEnd="-8dp"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:value="0"
                    app:thumbRadius="7dp"
                    app:trackHeight="4dp"
                    app:labelBehavior="gone" />

                <TextView
                    android:id="@+id/txtVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Spec dışı: hız kontrolü — dokununca 1x/1.5x/2x/0.5x
                 arasında döner (bkz. ChatActivity/PlaybackSpeedMenu). En az
                 40dp dokunma hedefi için padding'i büyütüldü. -->
            <TextView
                android:id="@+id/btnVoiceSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="1x"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtEditedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/lbl_edited"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/imgStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği: "görüldü" bildirimi — SADECE en son
         görülen mesajın altında (bkz. SimpleChatAdapter.applySeen, tüm
         önceki mesajlar örtük olarak görülmüş sayılır). Hem 1:1 (tek
         avatar) hem grup (birden fazla görenin avatarı) için aynı satır —
         gruplarda 3'ten fazla goren "+N" ile özetlenir. -->
    <LinearLayout
        android:id="@+id/rowSeenBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSeenBy1"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/msg_read" />

        <ImageView
            android:id="@+id/imgSeenBy2"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/imgSeenBy3"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtSeenByMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
