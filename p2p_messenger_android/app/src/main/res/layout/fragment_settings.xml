<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, grouped into collapsible cards (see SettingsFragment.setupSections).
     Every view id the fragment looks up is kept; only the arrangement changed. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/title_settings"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- ===================== Profile ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_profile_header"
                style="@style/Settings.Header"
                android:text="@string/settings_section_profile" />

            <LinearLayout android:id="@+id/section_profile_body" style="@style/Settings.Body">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/img_own_avatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/content_desc_profile_picture" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/display_name_value"
                            android:textAlignment="viewStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Settings.Desc"
                            android:text="@string/lbl_identity_code" />

                        <TextView
                            android:id="@+id/identity_code_value"
                            android:textDirection="ltr"
                            android:textAlignment="viewStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp">

                    <Button
                        android:id="@+id/btn_change_display_name"
                        style="@style/Settings.Button"
                        android:text="@string/action_change_display_name" />

                    <Button
                        android:id="@+id/btn_change_picture"
                        style="@style/Settings.Button"
                        android:text="@string/action_change_picture" />

                    <Button
                        android:id="@+id/btn_remove_picture"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_remove_picture" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/Settings.Desc"
                    android:layout_marginTop="4dp"
                    android:text="@string/lbl_display_name_desc" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Appearance ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_appearance_header"
                style="@style/Settings.Header"
                android:text="@string/lbl_chat_appearance" />

            <LinearLayout android:id="@+id/section_appearance_body" style="@style/Settings.Body">

                <LinearLayout style="@style/Settings.Row" android:minHeight="0dp">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_text_scale" />
                    <TextView
                        android:id="@+id/text_scale_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:alpha="0.7" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/text_scale_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="0" />

                <LinearLayout style="@style/Settings.Row" android:minHeight="0dp">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_ui_scale" />
                    <TextView
                        android:id="@+id/ui_scale_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:alpha="0.7" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/ui_scale_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="0" />

                <View style="@style/Settings.Divider" />

                <LinearLayout style="@style/Settings.Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/Settings.Title" android:text="@string/lbl_font_family" />
                        <TextView android:id="@+id/font_family_value" style="@style/Settings.Desc" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btn_pick_font"
                        style="@style/Settings.Button"
                        android:text="@string/action_choose" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_globe"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/Settings.Title" android:text="@string/lbl_language" />
                        <TextView android:id="@+id/language_value" style="@style/Settings.Desc" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btn_pick_language"
                        style="@style/Settings.Button"
                        android:text="@string/action_choose" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_chat_bg_color" />
                    <View
                        android:id="@+id/chat_bg_color_swatch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp" />
                    <Button
                        android:id="@+id/btn_pick_chat_bg_color"
                        style="@style/Settings.Button"
                        android:text="@string/action_choose" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_material_you" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/material_you_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_text_color" />
                    <View
                        android:id="@+id/text_color_swatch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp" />
                    <Button
                        android:id="@+id/btn_pick_text_color"
                        style="@style/Settings.Button"
                        android:text="@string/action_choose" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_accent_color" />
                    <View
                        android:id="@+id/accent_color_swatch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp" />
                    <Button
                        android:id="@+id/btn_pick_accent_color"
                        style="@style/Settings.Button"
                        android:text="@string/action_choose" />
                </LinearLayout>

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_chat_wallpaper" />
                    <ImageView
                        android:id="@+id/chat_wallpaper_thumb"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/content_desc_chat_wallpaper_preview" />
                    <Button
                        android:id="@+id/btn_remove_chat_wallpaper"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/action_remove_wallpaper" />
                    <Button
                        android:id="@+id/btn_pick_chat_wallpaper"
                        style="@style/Settings.Button"
                        android:text="@string/action_choose" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wallpaper_blur_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout style="@style/Settings.Row" android:minHeight="0dp">
                        <TextView
                            style="@style/Settings.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/lbl_wallpaper_blur" />
                        <TextView
                            android:id="@+id/wallpaper_blur_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:alpha="0.7" />
                    </LinearLayout>
                    <SeekBar
                    android:id="@+id/wallpaper_blur_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wallpaper_darkness_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout style="@style/Settings.Row" android:minHeight="0dp">
                        <TextView
                            style="@style/Settings.Title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/lbl_wallpaper_darkness" />
                        <TextView
                            android:id="@+id/wallpaper_darkness_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:alpha="0.7" />
                    </LinearLayout>
                    <SeekBar
                    android:id="@+id/wallpaper_darkness_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="90" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Privacy & security ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_privacy_header"
                style="@style/Settings.Header"
                android:text="@string/settings_section_privacy" />

            <LinearLayout android:id="@+id/section_privacy_body" style="@style/Settings.Body">

                <LinearLayout style="@style/Settings.Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/Settings.Title" android:text="@string/lbl_app_lock_section" />
                        <TextView style="@style/Settings.Desc" android:text="@string/lbl_app_lock_section_desc" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btn_change_app_password"
                        style="@style/Settings.Button"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_change_app_password" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notif_show_message_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:text="@string/lbl_notif_show_message" />
                <TextView style="@style/Settings.Desc" android:text="@string/lbl_notif_show_message_desc" />

                <View style="@style/Settings.Divider" />

                <TextView style="@style/Settings.Title" android:text="@string/lbl_key_security" />
                <TextView android:id="@+id/key_security_status" style="@style/Settings.Desc" />

                <View style="@style/Settings.Divider" />

                <TextView style="@style/Settings.Title" android:text="@string/lbl_recovery_export" />
                <TextView style="@style/Settings.Desc" android:text="@string/lbl_recovery_export_desc" />
                <Button
                    android:id="@+id/btn_export_recovery"
                    style="@style/Settings.Button"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_export_recovery" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Network ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_network_header"
                style="@style/Settings.Header"
                android:text="@string/settings_section_network" />

            <LinearLayout android:id="@+id/section_network_body" style="@style/Settings.Body">

                <TextView
                    android:id="@+id/tor_status"
                    style="@style/Settings.Desc"
                    android:alpha="1"
                    android:text="@string/tor_status_disabled"
                    android:textStyle="bold" />

                <View style="@style/Settings.Divider" />

                <TextView style="@style/Settings.Title" android:text="@string/lbl_tor_connection" />
                <TextView android:id="@+id/tor_mode_desc" style="@style/Settings.Desc" />
                <TextView style="@style/Settings.Desc" android:layout_marginTop="8dp" android:text="@string/msg_tor_mode_restart" />
                <TextView style="@style/Settings.Desc" android:layout_marginTop="8dp" android:autoLink="web" android:text="@string/msg_tor_bridges_help" />
                <TextView style="@style/Settings.Desc" android:layout_marginTop="8dp" android:text="@string/lbl_tor_snowflake_bridges" />
                <EditText
                    android:id="@+id/input_tor_snowflake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_tor_bridges"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="2"
                    android:maxLines="6"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    android:typeface="monospace" />
                <TextView style="@style/Settings.Desc" android:layout_marginTop="8dp" android:text="@string/lbl_tor_obfs4_bridges" />
                <EditText
                    android:id="@+id/input_tor_obfs4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_tor_bridges"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="2"
                    android:maxLines="6"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    android:typeface="monospace" />
                <TextView
                    android:id="@+id/tor_bridges_error"
                    style="@style/Settings.Desc"
                    android:alpha="1"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />
                <CheckBox
                    android:id="@+id/tor_always_bridge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_tor_always_bridge" />
                <TextView style="@style/Settings.Desc" android:text="@string/msg_tor_always_bridge" />
                <Button
                    android:id="@+id/btn_tor_save"
                    style="@style/Settings.Button"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_tor_save" />

                <View style="@style/Settings.Divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/beta_updates_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:text="@string/lbl_beta_updates" />
                <TextView style="@style/Settings.Desc" android:text="@string/lbl_beta_updates_desc" />
                <TextView android:id="@+id/update_status" style="@style/Settings.Desc" />
                <Button
                    android:id="@+id/btn_check_updates"
                    style="@style/Settings.Button"
                    android:text="@string/action_check_updates" />

                <View style="@style/Settings.Divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/node_mode_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:text="@string/lbl_node_mode" />
                <TextView style="@style/Settings.Desc" android:text="@string/lbl_node_mode_desc" />

                <!-- Only visible while node mode is on (see setHistoryStorageLimitVisible). -->
                <LinearLayout style="@style/Settings.Row" android:layout_marginTop="8dp" android:minHeight="0dp">
                    <TextView
                        android:id="@+id/history_storage_limit_label"
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/lbl_history_storage_limit" />
                    <TextView
                        android:id="@+id/history_storage_limit_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/history_storage_limit_desc"
                    style="@style/Settings.Desc"
                    android:text="@string/lbl_history_storage_limit_desc" />
                <SeekBar
                    android:id="@+id/history_storage_limit_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="8" />

                <View style="@style/Settings.Divider" />

                <TextView style="@style/Settings.Subheader" android:text="@string/settings_advanced" />
                <TextView
                    style="@style/Settings.Title"
                    android:layout_marginTop="6dp"
                    android:text="@string/lbl_relay_address" />
                <TextView style="@style/Settings.Desc" android:text="@string/lbl_relay_address_desc" />
                <LinearLayout style="@style/Settings.Row">
                    <EditText
                        android:id="@+id/relay_address_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/lbl_relay_address_hint"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/btn_add_relay_address"
                        style="@style/Settings.Button"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_add" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Servers ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_servers_header"
                style="@style/Settings.Header"
                android:text="@string/lbl_servers" />

            <LinearLayout android:id="@+id/section_servers_body" style="@style/Settings.Body">
                <TextView style="@style/Settings.Desc" android:text="@string/lbl_servers_desc" />

                <!-- Server rows are built in SettingsFragment.refreshServers(). -->
                <LinearLayout
                    android:id="@+id/servers_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp">
                    <Button
                        android:id="@+id/btn_add_server"
                        style="@style/Settings.Button"
                        android:text="@string/action_add_server" />
                    <Button
                        android:id="@+id/btn_add_server_paste"
                        style="@style/Settings.Button"
                        android:text="@string/action_add_server_paste" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Devices & messages ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_devices_header"
                style="@style/Settings.Header"
                android:text="@string/settings_section_devices" />

            <LinearLayout android:id="@+id/section_devices_body" style="@style/Settings.Body">
                <TextView style="@style/Settings.Title" android:text="@string/linked_devices_section_title" />
                <TextView style="@style/Settings.Desc" android:text="@string/linked_devices_section_desc" />
                <Button
                    android:id="@+id/btn_linked_devices"
                    style="@style/Settings.Button"
                    android:layout_marginTop="8dp"
                    android:text="@string/linked_devices_manage" />

                <View style="@style/Settings.Divider" />

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/action_view_pending_messages" />
                    <Button
                        android:id="@+id/btn_pending_messages"
                        style="@style/Settings.Button"
                        android:text="@string/action_open" />
                </LinearLayout>

                <View style="@style/Settings.Divider" />

                <LinearLayout style="@style/Settings.Row">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/action_view_storage" />
                    <Button
                        android:id="@+id/btn_storage"
                        style="@style/Settings.Button"
                        android:text="@string/action_open" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== Account (destructive) ===================== -->
    <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/section_account_header"
                style="@style/Settings.Header"
                android:textColor="?attr/colorError"
                android:drawableTint="?attr/colorError"
                android:text="@string/settings_section_account" />

            <LinearLayout android:id="@+id/section_account_body" style="@style/Settings.Body">
                <TextView style="@style/Settings.Title" android:text="@string/logout_section_title" />
                <TextView style="@style/Settings.Desc" android:text="@string/logout_section_desc" />
                <Button
                    android:id="@+id/btn_logout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_logout"
                    android:textColor="?attr/colorError"
                    app:strokeColor="?attr/colorError" />

                <View style="@style/Settings.Divider" />

                <TextView style="@style/Settings.Title" android:text="@string/action_delete_account" />
                <TextView style="@style/Settings.Desc" android:text="@string/delete_account_confirm_message" />
                <Button
                    android:id="@+id/btn_delete_account"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="?attr/colorError"
                    android:textColor="?attr/colorOnError"
                    android:text="@string/action_delete_account" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txt_app_version"
        style="@style/Settings.Desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal" />

</LinearLayout>

