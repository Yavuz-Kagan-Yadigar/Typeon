<?xml version="1.0" encoding="utf-8"?>
<!-- Spec dışı, kullanıcı isteği: "soldan bir drag barla sürüklenebilir
     açılıp kapanan chat list" — sohbet ekranından ayrılmadan başka bir
     sohbete geçebilmek için soldan açılan bir çekmece. `DrawerLayout`
     bilinçli seçim: Android'in kendi standart "kenardan kaydırarak aç/
     kapat" bileşeni (Gmail/Slack/Discord'un kanal listesi de AYNI desen) —
     kendiliğinden hem kaydırma jestini hem programatik aç/kapatmayı verir.
     Sürekli-değişken genişlikte bir sürükle-boyutlandırma (masaüstündeki
     Linux sürümünün aksine, bkz. Linux/src/ui/window.rs) telefon
     genişliğinde pratik bir fayda sağlamıyor — standart gezinme çekmecesi
     genişliği (bkz. aşağıdaki 304dp) kullanılıyor.
     İLK çocuk = asıl ekran içeriği (aşağıdaki `rootChatLayout`, DEĞİŞMEDİ);
     İKİNCİ çocuk = çekmece içeriği (`layout_gravity="start"` ZORUNLU, bu
     DrawerLayout'un onu "sol çekmece" olarak tanımasının TEK yolu). -->
<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/chatDrawerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Spec dışı, kullanıcı isteği: sohbet duvarkağıdı — Ayarlar'daki
         "arka plan rengi"/"duvarkağıdı" tercihleri (bkz. ThemePrefs/
         ChatActivity.applyChatBackgroundPrefs). En üstte, İLK çocuk olarak
         eklendi (ConstraintLayout çocukları XML bildirim sırasına göre
         çizilir) — böylece diğer TÜM içeriğin ARKASINDA kalır. Duvarkağıdı
         yoksa GONE, tercih edilen arka plan rengi (varsa) doğrudan
         `rootChatLayout`'a uygulanır. -->
    <ImageView
        android:id="@+id/imgChatWallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spec dışı sağlamlaştırma: el sıkışma tamamlanana kadar gösterilir
         (bkz. ChatActivity — ensureHandshake/hasActiveSession). Kullanıcı
         "bağlantı yeni kurulduysa ilk mesajlar kayboluyor gibi görünüyor"
         diye şikayet etmişti; artık mesajlar zaten hiç kaybolmuyor (bkz.
         Rust pending_envelopes) ama bu banner en azından NEDEN bir gecikme
         olabileceğini açıkça gösteriyor. -->
    <LinearLayout
        android:id="@+id/layoutConnecting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/txtConnectingBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_securing_no_send"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği: sohbet içi mesaj arama — toolbar'daki
         arama simgesiyle açılıp kapanır (bkz. ChatActivity/GroupChatActivity
         toggleMessageSearch). -->
    <LinearLayout
        android:id="@+id/layoutSearchMessages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutConnecting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:iconifiedByDefault="false"
            app:queryHint="@string/hint_search_messages" />

        <TextView
            android:id="@+id/txtSearchMatchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnSearchPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/round_icon_button_background"
            android:contentDescription="@string/action_search_prev"
            android:src="@android:drawable/arrow_up_float" />

        <ImageButton
            android:id="@+id/btnSearchNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/round_icon_button_background"
            android:contentDescription="@string/action_search_next"
            android:src="@android:drawable/arrow_down_float" />

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği: alt çubuk TEK bir "pill" içinde ve
         pill'in yanlarında/altında %2'lik boşluk. Sabit bir dp yerine
         `Guideline` + `layout_constraintGuide_percent`: istenen boşluk
         ORANSAL, yani telefonda da tablette de ekranın %2'si kadar kalır
         (sabit dp, geniş ekranda görsel olarak çok daha dar görünürdü).
         Aynı üç kılavuz hem giriş çubuğu hem de onun YERİNE geçen ses
         kaydı çubuğu tarafından kullanılıyor, böylece ikisi birebir aynı
         yerde duruyor. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInputStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.02" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInputEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.98" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInputBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />

    <!-- Spec dışı, kullanıcı isteği: "alt barla mesaj arasında %5 dikey
         padding". Sabit bir dp DEĞİL — istenen oransal, bu yüzden yüksekliği
         ebeveynin %5'ine bağlı boş bir `Space`. Giriş çubuğunun kendi
         yüksekliği (çok satırlı yazarken) değiştiği için bunu bir
         `Guideline` ile ifade etmek mümkün değil: kılavuz ekrana göre
         sabittir, bu boşluk ise çubuğun ÜSTÜNE yapışmalı. -->
    <Space
        android:id="@+id/spaceAboveInput"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.05"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spec dışı, kullanıcı isteği: "alt barın üstünde sürekli bir siyah
         bar var, kaldır" + "alt bar ve alıntı pillinin DIŞI şeffaf olsun,
         chat yanlardan ve alttan görünsün".
         İkisi aynı şeyin sonucu: liste eskiden giriş çubuğunun ÜSTÜNDE
         bitiyordu, dolayısıyla çubuğun etrafında/altında kalan şerit
         sohbetin değil pencerenin arka planıydı — o "siyah bar" buydu.
         Artık liste ekranın ALTINA kadar uzanıyor; çubuk ve alıntı pili
         onun ÜSTÜNDE yüzüyor (XML'de listeden SONRA bildirildikleri için
         üstte çiziliyorlar). `clipToPadding=false`: içerik pillerin
         ARKASINDAN kayarak geçer ama dinlenme konumunda onların üstünde
         durur — alt dolgu çalışma zamanında çubuğun gerçek yüksekliğine
         göre veriliyor (bkz. ChatActivity `syncRecyclerBottomInset`). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchMessages" />

    <!-- Spec dışı: "yazıyor..." göstergesi — kullanıcı isteği üzerine üst
         çubuktaki durum yazısından buraya, yeni mesajların BELİRECEĞİ
         noktaya (mesaj listesinin hemen altına, karşı taraf balonu gibi)
         taşındı. bkz. ChatActivity peerIsTyping. `imgTypingAvatar`: group
         chat only, shows who's typing (GONE in 1:1). -->
    <LinearLayout
        android:id="@+id/layoutTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bubble_theirs"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/spaceAboveInput"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgTypingAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtTypingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_typing"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği (WhatsApp tarzı "yanıtla"): bir mesajı
         sağa kaydırınca (bkz. SimpleChatAdapter/ChatActivity.setupSwipeToReply)
         gösterilir — hangi mesaja yanıt verildiğini gösterir, X ile iptal
         edilebilir. `txtReplyPreviewSender`: 1:1'de sabit "Yanıtlanıyor"/
         kişi adı, grup da yanıtlanan mesajın göndericisinin adı (bkz.
         ChatActivity/GroupChatActivity `startReply`). -->
    <!-- Kullanıcı isteği: alıntı artık ayrı bir pill DEĞİL; kendi arka planı
         yok, alt çubukla birlikte `viewReplyIsland` adasının içinde duruyor
         (adanın kenarlarından 12dp içeride, çubuğun hemen üstünde). -->
    <!-- Kullanıcı isteği: alıntı + alt çubuk tek bir ADA içinde (bkz.
         reply_island.xml). Ada çubuğun ETRAFINA taşar, çubuğu yeniden
         boyutlandırmaz: yan/alt kenarları çubuğun gerçek konumundan kodda
         hesaplanır (bkz. util.ReplyIsland; ConstraintLayout negatif kenar
         boşluğu desteklemiyor). XML'de ikisinden ÖNCE: arkada çizilsin. -->
    <View
        android:id="@+id/viewReplyIsland"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/reply_island"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/layoutReplyPreview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutReplyPreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageInput"
        app:layout_constraintStart_toStartOf="@id/guideInputStart"
        app:layout_constraintEnd_toEndOf="@id/guideInputEnd">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReplyPreviewSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txtReplyPreviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/action_cancel_reply" />

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği: ek/kamera/ses düğmeleri, metin alanı ve
         gönder tuşu HEPSİ tek bir dış pill'in (bkz. message_bar_pill.xml)
         içinde; o pill'in İÇİNDE de düğme grubu SADECE ince çerçeveli bir
         pill (bkz. message_bar_inner_pill.xml — dolgusuz, yalnızca kontur).
         Metin alanının kendi çerçevesi kullanıcı isteğiyle KALDIRILDI —
         dış pill zaten onu sarıyor. Düğmelerin eski dolgulu dairesel
         arkaplanları (`round_icon_button_background`) kaldırıldı: artık
         çerçeveyi grup taşıyor, düğmelerde yalnızca kenarlıksız dokunma
         dalgası (ripple) var. -->
    <LinearLayout
        android:id="@+id/layoutMessageInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@drawable/message_bar_pill"
        app:layout_constraintBottom_toTopOf="@id/guideInputBottom"
        app:layout_constraintStart_toStartOf="@id/guideInputStart"
        app:layout_constraintEnd_toEndOf="@id/guideInputEnd">

        <!-- Ek + kamera + ses: TEK bir ince çerçevenin içinde (kullanıcı
             isteği), üçü bir grup olarak okunuyor.

             Spec dışı, hata düzeltmesi (kullanıcı: "üçlü buton pilli ve dış
             pill arası hep aynı mesafede olsun, şu an pilin ucunda daha
             yakın"): bu üç düğme önceden 38dp'ydi, gönder düğmesi (aşağıda)
             44dp — satırın toplam yüksekliği en UZUN kardeşe (44dp'lik
             gönder düğmesi) göre belirlendiğinden, bu iç pil dikeyde
             `center_vertical` ile ekstra bir "gevşeklik" payıyla ortalanıyor
             ve dış pilin üstü/altıyla arasındaki boşluk, dış pilin SOLUYLA
             arasındaki boşluktan (salt üst LinearLayout dolgusundan gelen,
             6dp) daha GENİŞ oluyordu — yuvarlak uçta bu fark göze
             çarpıyordu. Üç düğmeyi de gönder düğmesiyle AYNI 44dp/10dp
             yapmak bu gevşekliği sıfırlıyor: dört yönde de boşluk artık
             SADECE dış `layoutMessageInput`'un 6dp dolgusundan geliyor. -->
        <LinearLayout
            android:id="@+id/rowInputActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:background="@drawable/message_bar_inner_pill">

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_attach_file"
                android:src="@drawable/ic_attach" />

            <!-- Spec dışı, kullanıcı isteği: ek düğmesinin YANINDA doğrudan
                 kamera — anlık çekim + kırpma, galeriye/diske hiç yazmadan
                 (bkz. ui.CameraCaptureActivity). Dosya seçiciden bir fotoğraf
                 seçmekten AYRI bir akış. -->
            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_take_photo"
                android:src="@drawable/ic_camera" />

            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_record_voice"
                android:src="@drawable/ic_mic" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_message"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:background="@null"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Spec dışı, kullanıcı isteği: gönderim sırasında (JNI/ratchet
             şifreleme çağrısı arka plan thread'inde çalışırken, bkz.
             ChatActivity/GroupChatActivity sendNewMessage) düğmenin YERİNE
             dönen bir yükleniyor göstergesi + çift dokunuşu engellemek için
             düğmenin devre dışı bırakılması. Aynı FrameLayout hücresinde
             ikisi de aynı boyutu kapladığından düğme gizlenince (INVISIBLE,
             GONE DEĞİL — yer kaplamaya devam etsin, aksi halde çevredeki
             satır sıçrardı) düzen sıçramaz. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Spec dışı, kullanıcı isteği: gönder tuşunun simgesi artık
                 uygulamanın kendi bulut+yağmur logosu, MASKE olarak —
                 `ic_send_cloud` tek renk bir siluet, gerçek rengini
                 buradaki `tint`ten alır (bkz. o dosyanın notu). Metin
                 taşıyan `Button` yerine `ImageButton`: bir Button'ın
                 `drawable`'ı metin hizalamasıyla birlikte konumlanır ve
                 dairesel bir tuşta ortalanmaz. -->
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:background="@drawable/send_button_background"
                android:src="@drawable/ic_send_cloud"
                android:tint="?attr/colorOnPrimary"
                android:contentDescription="@string/btn_send" />

            <ProgressBar
                android:id="@+id/progressSending"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="?attr/colorPrimary" />

        </FrameLayout>

    </LinearLayout>

    <!-- Spec dışı: basılı tut/kaydet sesli mesaj — kayıt sırasında input
         satırının YERİNE geçer (bkz. ChatActivity ses kaydı akışı). Sağa
         kaydırınca iptal (bkz. txtCancelPill — parmakla birlikte kayar),
         bırakınca gönderilir. -->
    <LinearLayout
        android:id="@+id/layoutRecording"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/message_bar_pill"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/guideInputBottom"
        app:layout_constraintEnd_toEndOf="@id/guideInputEnd"
        app:layout_constraintStart_toStartOf="@id/guideInputStart">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_status_pending"
            app:tint="?attr/colorError"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Parmakla BİRLİKTE sağa kayan (translationX, bkz. ChatActivity
             setupVoiceRecordButton) iptal pili — sabit kalan kayıt
             göstergesinin (yukarıdaki nokta+zamanlayıcı) aksine. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtCancelPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/message_input_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/msg_recording_voice"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </FrameLayout>

    </LinearLayout>

    <!-- Spec dışı, kullanıcı isteği: 15 dakikadır sessiz bir sohbete mesaj
         geldiğinde/gittiğinde oynayan hafif parçacık efekti (bkz.
         ui.TyphoonParticleView). Mesaj listesinin ÜSTÜNE, ama alt çubuğun
         ALTINA denk gelen bir katman — XML sırası gereği listeden sonra
         çiziliyor. Dokunuşları tüketmez. -->
    <com.p2p.messenger.ui.TyphoonParticleView
        android:id="@+id/typhoonEffect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerMessages"
        app:layout_constraintBottom_toBottomOf="@id/recyclerMessages"
        app:layout_constraintStart_toStartOf="@id/recyclerMessages"
        app:layout_constraintEnd_toEndOf="@id/recyclerMessages" />

    <!-- Bottom-right scroll-to-bottom FAB (see ChatActivity/GroupChatActivity
         isRecyclerNearBottom/onNewIncomingItemAdded): shown + blinking when
         a new message arrives while scrolled up; tap to jump to bottom. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollToBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/arrow_down_float"
        android:contentDescription="@string/action_scroll_to_bottom"
        android:visibility="gone"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/barrierAboveInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Aşağı kaydır" düğmesi hem alt çubuğun hem (varsa) alıntı adasının
         ÜSTÜNDE dursun: görünmeyen (gone) ada hesaba katılmaz. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAboveInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="viewReplyIsland,layoutMessageInput" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- bkz. dosya başı DrawerLayout notu — çekmece içeriği: mevcut
         `ChatsFragment`'in AYNI örneği (MainActivity'nin sekmesiyle KODU
         paylaşır, ayrı bir sohbet listesi yeniden yazılmadı). `android:name`
         ile bildirilen bir `FragmentContainerView`, layout şişirilirken
         fragment'ı KENDİLİĞİNDEN oluşturur — ayrı bir FragmentTransaction
         gerekmez. Genişlik: standart Material gezinme çekmecesi genişliği
         (304dp) — dosya başı notundaki gerekçeyle sabit, sürüklenerek
         değiştirilmiyor. `android:fitsSystemWindows`: çekmece kendi
         durum çubuğu/kenar boşluklarını doğru hesaplasın diye. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chatListDrawerContainer"
        android:name="com.p2p.messenger.ChatsFragment"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="?attr/colorSurface" />

</androidx.drawerlayout.widget.DrawerLayout>
