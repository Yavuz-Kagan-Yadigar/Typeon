<?xml version="1.0" encoding="utf-8"?>
<!-- Left-edge drawer holding the chat list, opened by dragging from the edge, so the user can
     switch to another chat without leaving this screen. DrawerLayout is a deliberate choice: it
     is Android's standard swipe-from-edge component (the channel list in Gmail, Slack and
     Discord uses the same pattern), and it gives both the swipe gesture and programmatic open
     and close. A continuously resizable drag-to-resize panel, as in the Linux desktop client
     (see Linux/src/ui/window.rs), gives no practical benefit on a phone, so the standard
     navigation drawer width is used (304dp, below). The FIRST child is the main screen content
     (rootChatLayout below, unchanged). The SECOND child is the drawer content.
     layout_gravity="start" is required: it is the only way DrawerLayout recognises it as the
     left drawer. -->
<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/chatDrawerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <!-- Chat wallpaper: the background colour and wallpaper preferences in Settings (see
         ThemePrefs and ChatActivity.applyChatBackgroundPrefs). Added as the FIRST child, so it
         sits behind all other content, because ConstraintLayout children are drawn in XML
         declaration order. With no wallpaper it is GONE, and the preferred background colour,
         if set, is applied directly to rootChatLayout. -->
    <!-- Top only, height = screen height (set in ThemePrefs.applyChatBackground):
         pinned to the bottom too, it shrank with the keyboard and centerCrop
         moved the picture up. -->
    <ImageView
        android:id="@+id/imgChatWallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <!-- Shown until the handshake completes (see ChatActivity ensureHandshake and
         hasActiveSession). Users reported that the first messages seemed lost right after a new
         connection. Messages are no longer lost (see the Rust pending_envelopes), but this
         banner at least shows clearly why there may be a delay. -->
    <LinearLayout
        android:id="@+id/layoutConnecting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/txtConnectingBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_securing_no_send"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

        <!-- In-chat message search, opened and closed with the search icon on the toolbar (see
         ChatActivity and GroupChatActivity toggleMessageSearch). -->
    <LinearLayout
        android:id="@+id/layoutSearchMessages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutConnecting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:iconifiedByDefault="false"
            app:queryHint="@string/hint_search_messages" />

        <TextView
            android:id="@+id/txtSearchMatchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnSearchPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/round_icon_button_background"
            android:contentDescription="@string/action_search_prev"
            android:src="@android:drawable/arrow_up_float" />

        <ImageButton
            android:id="@+id/btnSearchNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/round_icon_button_background"
            android:contentDescription="@string/action_search_next"
            android:src="@android:drawable/arrow_down_float" />

    </LinearLayout>

        <!-- The bottom bar is one pill, with a 2% gap on its sides and below. Instead of a fixed dp
         value, a Guideline with layout_constraintGuide_percent is used. The gap is
         proportional, so it stays 2% of the screen on phone and tablet alike (a fixed dp value
         looked much narrower on wide screens). The same three guidelines are used by the input
         bar and by the voice-recording bar that replaces it, so both sit in exactly the same
         place. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInputStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.02" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInputEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.98" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideInputBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />

        <!-- Vertical padding of 5% between the bottom bar and the messages. Not a fixed dp: it is
         an empty Space whose height is 5% of the parent. A Guideline cannot express this,
         because the input bar's own height changes while several lines are typed. A guideline
         is fixed to the screen, but this gap has to stick to the top of the bar. -->
    <Space
        android:id="@+id/spaceAboveInput"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintBottom_toTopOf="@id/layoutMessageInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <!-- There was a constant black strip below the bottom bar. The requested change was to
         remove it, and to let the chat show through at the sides and below the bar and the
         quote pill. Both come from the same cause: the list used to end ABOVE the input bar, so
         the strip around and below the bar was the window background, not the chat's. That was
         the black bar. Now the list extends to the bottom of the screen, and the bar and the
         quote pill float on top of it (they are declared after the list in XML, so they are
         drawn on top). clipToPadding=false: content slides behind the pills and rests above
         them. The bottom padding is set at run time from the bar's real height (see
         ChatActivity syncRecyclerBottomInset). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/whiteboardHost" />

    <!-- Shared whiteboard (see ui.WhiteboardPanel). Empty and gone until
         first opened; the message list starts below it, so the chat stays
         usable while drawing. -->
    <FrameLayout
        android:id="@+id/whiteboardHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchMessages"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The pull tab of the whiteboard: hangs under the top bar (or under the
         open board), centred, over the top of the message list. -->
    <View
        android:id="@+id/whiteboardHandle"
        android:layout_width="112dp"
        android:layout_height="28dp"
        android:contentDescription="@string/action_whiteboard"
        app:layout_constraintTop_toBottomOf="@id/whiteboardHost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Fetch older history": the only place a chat asks the network for
         history (see ui.FetchHistoryButton). Shown at the top of the list
         while it cannot scroll further up. -->
    <Button
        android:id="@+id/btnFetchHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/action_fetch_older_history"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/whiteboardHandle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <!-- The typing indicator. It was moved from the status text in the top bar to the point
         where new messages will appear: just below the message list, like a peer bubble (see
         ChatActivity peerIsTyping). imgTypingAvatar: group chat only, shows who is typing (GONE
         in 1:1). -->
    <LinearLayout
        android:id="@+id/layoutTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bubble_theirs"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/spaceAboveInput"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgTypingAvatar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtTypingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_typing"
            android:textSize="12sp" />

    </LinearLayout>

        <!-- The attach, camera and voice buttons, the text field and the send button are all inside
         one outer pill (see message_bar_pill.xml). Inside that pill, the button group is a pill
         with a thin frame only (see message_bar_inner_pill.xml: no fill, outline only). The
         text field's own frame was removed, since the outer pill already wraps it. The buttons'
         old solid circular backgrounds (round_icon_button_background) were removed: the group
         now carries the frame, and the buttons have only a borderless ripple. -->
    <LinearLayout
        android:id="@+id/layoutMessageInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@drawable/message_bar_pill"
        app:layout_constraintBottom_toTopOf="@id/guideInputBottom"
        app:layout_constraintStart_toStartOf="@id/guideInputStart"
        app:layout_constraintEnd_toEndOf="@id/guideInputEnd">

                <!-- Attach, camera and voice sit inside ONE thin frame and read as a group. Bug fix
             (the pill's ends looked closer to the outer pill than its sides): these three
             buttons were 38dp, and the send button below is 44dp. The row's total height
             follows the tallest sibling, so this inner pill was centred with extra slack via
             center_vertical, and the gap between the outer pill's top and bottom and the inner
             pill was wider than the gap on the left side (6dp, from the parent LinearLayout
             padding only). At the rounded end the difference was visible. Making all three
             buttons 44dp with 10dp, the same as the send button, removes that slack: on all
             four sides the gap now comes only from the outer layoutMessageInput 6dp padding. -->
        <LinearLayout
            android:id="@+id/rowInputActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:background="@drawable/message_bar_inner_pill">

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_attach_file"
                android:src="@drawable/ic_attach" />

                        <!-- Camera directly beside the attach button: instant capture and crop, never
                 written to the gallery or disk (see ui.CameraCaptureActivity). A separate flow
                 from picking a photo in the file picker. -->
            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_take_photo"
                android:src="@drawable/ic_camera" />

            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_record_voice"
                android:src="@drawable/ic_mic" />

            <!-- Sticker picker (ui.StickerPicker). -->
            <ImageButton
                android:id="@+id/btnSticker"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_stickers"
                android:src="@drawable/ic_sticker" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_message"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:background="@null"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

                <!-- While a message is being sent (the JNI and ratchet encryption call runs on a
             background thread, see ChatActivity and GroupChatActivity sendNewMessage), a
             loading indicator replaces the button, and the button is disabled to prevent double
             taps. Both sit in the same FrameLayout cell and take the same size. When the button
             is hidden it is INVISIBLE, not GONE, so it keeps taking up space and the
             neighbouring row does not jump. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

                        <!-- The send icon is now the app's own cloud and rain logo, as a mask.
                 ic_send_cloud is a single-colour silhouette, and its real colour comes from the
                 tint here (see the note in that file). It uses an ImageButton rather than a
                 text Button: a Button's drawable is positioned together with the text
                 alignment, so it would not centre in a circular button. -->
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:background="@drawable/send_button_background"
                android:src="@drawable/ic_send_cloud"
                android:tint="?attr/colorOnPrimary"
                android:contentDescription="@string/btn_send" />

            <ProgressBar
                android:id="@+id/progressSending"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="?attr/colorPrimary" />

        </FrameLayout>

    </LinearLayout>

        <!-- Press-and-hold voice message. While recording, it replaces the input row (see the
         ChatActivity voice recording flow). Sliding right cancels (see txtCancelPill, which
         slides with the finger), and releasing sends. -->
    <LinearLayout
        android:id="@+id/layoutRecording"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/message_bar_pill"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/guideInputBottom"
        app:layout_constraintEnd_toEndOf="@id/guideInputEnd"
        app:layout_constraintStart_toStartOf="@id/guideInputStart">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_status_pending"
            app:tint="?attr/colorError"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Cancel pill that slides right with the finger (translationX, see ChatActivity
             setupVoiceRecordButton), unlike the fixed recording indicator above it (the dot and
             timer). -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtCancelPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/message_input_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/msg_recording_voice"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </FrameLayout>

    </LinearLayout>

        <!-- A light particle effect that plays when a message comes in or goes out, in a chat that
         has been quiet for 15 minutes (see ui.TyphoonParticleView). It is a layer above the
         message list but below the bottom bar. In XML order it is drawn after the list. It does
         not consume touches. -->
    <com.p2p.messenger.ui.TyphoonParticleView
        android:id="@+id/typhoonEffect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerMessages"
        app:layout_constraintBottom_toBottomOf="@id/recyclerMessages"
        app:layout_constraintStart_toStartOf="@id/recyclerMessages"
        app:layout_constraintEnd_toEndOf="@id/recyclerMessages" />

    <!-- Bottom-right scroll-to-bottom FAB (see ChatActivity/GroupChatActivity
         isRecyclerNearBottom/onNewIncomingItemAdded): shown + blinking when
         a new message arrives while scrolled up; tap to jump to bottom. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollToBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/arrow_down_float"
        android:contentDescription="@string/action_scroll_to_bottom"
        android:visibility="gone"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/barrierAboveInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The scroll-down button sits above the input bar. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAboveInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="layoutMessageInput" />

</androidx.constraintlayout.widget.ConstraintLayout>

        <!-- See the DrawerLayout note at the top of the file. Drawer content: the same instance of
         the existing ChatsFragment (it shares code with the tab in MainActivity, so the chat
         list was not rewritten). A FragmentContainerView declared with android:name creates the
         fragment itself while the layout is inflated, so no separate FragmentTransaction is
         needed. Width: the standard Material navigation drawer width (304dp). It is fixed for
         the reason in the file-level note, not changed by dragging. android:fitsSystemWindows
         lets the drawer work out its own status bar and edge insets correctly. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chatListDrawerContainer"
        android:name="com.p2p.messenger.ChatsFragment"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="?attr/colorSurface" />

</androidx.drawerlayout.widget.DrawerLayout>
