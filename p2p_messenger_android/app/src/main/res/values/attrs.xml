<resources>
        <!-- Font choice from the system fonts in Settings: Material3's type scale styles (see
         TextAppearance.P2PMessenger.* in themes.xml) read fontFamily from this theme attribute.
         So changing only this one attribute, through ThemeOverlay.P2PMessenger.Font.* (see
         themes.xml), changes the whole type scale (body, title, label) at once. There is no
         need for 13 or more separate TextAppearance overrides for each font. -->
    <attr name="appFontFamily" format="string" />
</resources>
