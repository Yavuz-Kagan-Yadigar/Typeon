    <!-- Spec dışı, güvenlik denetimi devamı: bu metin ÖNCEDEN yanlıştı —
         Node modu şimdiye kadar sadece DHT routing'e katkı sağlıyordu,
         gerçek bir röle görevi görmüyordu (bkz. SECURITY.md "Cross-network
         connectivity" notu). Artık gerçekten doğru. -->
    <string name="lbl_node_mode_desc">Contributes to DHT routing AND blindly relays (encrypted) traffic for others on the network — it can never see your content, but it uses the bandwidth of whoever you relay for, and can see who they connect to.</string>
    <string name="lbl_history_storage_limit">Attachment storage limit</string>
    <string name="lbl_history_storage_limit_desc">Node Mode auto-downloads every file offered to it, which can grow without bound. Once total attachment storage passes this limit, the oldest files are deleted first to make room.</string>
    <string name="lbl_relay_address">Known relay address</string>
    <string name="lbl_relay_address_desc">So two people on different networks (both behind NAT) with no shared relay history can pair for the first time — if you have a relay you trust or run yourself (a reachable device with Node Mode on), add its address here.</string>
    <string name="lbl_relay_address_hint">/ip4/1.2.3.4/tcp/4001/p2p/12D3Koo…</string>
    <string name="action_add_relay_address">Add</string>
    <string name="msg_relay_address_added">Relay address added</string>
    <!-- Sunucular (store-and-forward) -->
    <string name="lbl_servers">Servers</string>
    <string name="lbl_servers_desc">A server holds your messages while the other person is offline, and delivers them when they come back. It never sees your messages: they stay end-to-end encrypted and are sealed a second time before being stored. Unlike a relay, a server does store — a relay only forwards while both sides are online.</string>
