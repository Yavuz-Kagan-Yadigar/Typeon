<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Voice / video call (1:1 and group — this menu is shared). -->
    <item
        android:id="@+id/action_voice_call"
        android:icon="@drawable/voicecall"
        android:title="@string/action_voice_call"
        app:showAsAction="ifRoom" />
    <item
        android:id="@+id/action_video_call"
        android:icon="@drawable/videocall"
        android:title="@string/action_video_call"
        app:showAsAction="ifRoom" />

    <!-- Group chat only: a call is running there. Replaces the two call
         buttons; tapping it joins (see GroupChatActivity.refreshCallOffer). -->
    <item
        android:id="@+id/action_attend_call"
        android:title="@string/action_attend_call"
        android:visible="false"
        app:actionLayout="@layout/menu_attend_pill"
        app:showAsAction="always" />

        <!-- In-chat message search. -->
    <item
        android:id="@+id/action_search_messages"
        android:icon="@drawable/search"
        android:title="@string/action_search_messages"
        app:showAsAction="always" />

        <!-- Disappearing messages picker (ui/Disappear.kt). Shared by ChatActivity and GroupChatActivity. -->
    <item
        android:id="@+id/action_disappear"
        android:icon="@drawable/ic_chat_timer"
        android:title="@string/disappear_title"
        app:showAsAction="always" />
</menu>
