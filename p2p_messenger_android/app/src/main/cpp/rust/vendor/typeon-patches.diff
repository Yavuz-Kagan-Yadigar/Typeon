+/// Typeon patch: removes a pending channel entry when the future building it is dropped (see the
+/// `Action::Launch` arm of `get_or_launch_internal`).
+struct PendingGuard<'a, CF: AbstractChannelFactory> {
+    /// The channel map holding the pending entry.
+    channels: &'a state::MgrState<CF>,
+    /// Taken by the normal paths, which remove or upgrade the entry themselves.
+    handle: Option<state::PendingChannelHandle>,
+}
+
+impl<CF: AbstractChannelFactory> Drop for PendingGuard<'_, CF> {
+    fn drop(&mut self) {
+        if let Some(handle) = self.handle.take() {
+            let _ = self.channels.remove_pending_channel(handle);
+        }
+    }
+}
