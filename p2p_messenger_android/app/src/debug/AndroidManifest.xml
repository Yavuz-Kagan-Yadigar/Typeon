<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: this source set is not part of a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- adb workflow: writes the database key to the app's private files
             dir (see DebugDbKeyReceiver). DUMP is held by the adb shell and
             by no ordinary app. -->
        <receiver
            android:name=".DebugDbKeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
