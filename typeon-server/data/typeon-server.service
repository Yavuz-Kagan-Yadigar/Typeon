# TypeOn server: systemd unit example.
#
#   sudo install -m 0755 typeon-server /usr/local/bin/
#   sudo cp typeon-server.service /etc/systemd/system/
#   sudo useradd --system --home /var/lib/typeon-server typeon
#   sudo install -d -o typeon -g typeon /var/lib/typeon-server
#   sudo systemctl enable --now typeon-server
#
# Join code and invite (run while the server is RUNNING. Management commands only open
# the database and read the onion address the server last announced from it):
#
#   sudo -u typeon /usr/local/bin/typeon-server --dir /var/lib/typeon-server join-code
#   sudo -u typeon /usr/local/bin/typeon-server --dir /var/lib/typeon-server invite new my-phone 1 7
#
# Data path and disk budget are the --dir and --storage options on ExecStart. Change
# both together with ReadWritePaths if you move the data directory (and drop
# StateDirectory, which only manages /var/lib/typeon-server).

[Unit]
Description=Typeon store-and-forward server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=typeon
Group=typeon
# --storage: total disk the server may use (mail + archive + blobs). Bytes, or
# K/M/G/T (powers of 1024). Set it to suit your disk.
# Self-update: the server downloads new releases over Tor and stages them in its data
# directory (it cannot write /usr/local/bin), then exits 75. "+" runs this one step
# outside the sandbox: the INSTALLED (root-owned) binary checks the staged one against
# the owner's offline release signature before it replaces itself. The service user
# writes the staged files, so they are never installed unchecked. Beta channel:
#   sudo -u typeon /usr/local/bin/typeon-server --dir /var/lib/typeon-server updates beta on
ExecStartPre=+/usr/local/bin/typeon-server --dir /var/lib/typeon-server install-staged
ExecStart=/usr/local/bin/typeon-server --dir /var/lib/typeon-server --storage 16G run
Restart=on-failure
RestartSec=5

# Tor is always on: the server is reachable only at its own .onion address (the
# listener is on 127.0.0.1). No port forwarding, domain or TLS is needed.
Environment=TYPEON_SERVER_NAME=Typeon

# The server writes only to its own data directory. The database holds the libp2p key
# and the join token, so the files are readable by the owner only.
UMask=0077
StateDirectory=typeon-server
StateDirectoryMode=0700
ReadWritePaths=/var/lib/typeon-server
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
# AF_NETLINK: needed to watch network interface changes (libp2p if-watch).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
ProtectProc=invisible
RemoveIPC=true
# Not set: ProcSubset=pid hides /proc/uptime, which the clock-jump guard reads.

# Database encryption at rest (SQLCipher). The key file holds 64 hex characters:
#   sudo install -d -m 0700 /etc/typeon-server
#   openssl rand -hex 32 | sudo tee /etc/typeon-server/db.key >/dev/null; sudo chmod 0600 /etc/typeon-server/db.key
#LoadCredential=dbkey:/etc/typeon-server/db.key
#Environment=TYPEON_SERVER_DB_KEY_FILE=%d/dbkey

[Install]
WantedBy=multi-user.target
