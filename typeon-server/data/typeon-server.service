# TypeOn server: systemd unit example.
#
#   sudo cp data/typeon-server.service /etc/systemd/system/
#   sudo useradd --system --home /var/lib/typeon-server typeon
#   sudo install -d -o typeon -g typeon /var/lib/typeon-server
#   sudo systemctl enable --now typeon-server
#
# Join code and invite (run while the server is RUNNING. Management commands only open
# the database and read the onion address the server last announced from it):
#
#   sudo -u typeon TYPEON_SERVER_DIR=/var/lib/typeon-server \
#        /usr/local/bin/typeon-server join-code
#   sudo -u typeon TYPEON_SERVER_DIR=/var/lib/typeon-server \
#        /usr/local/bin/typeon-server invite new my-phone 1 7

[Unit]
Description=Typeon store-and-forward server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=typeon
Group=typeon
ExecStart=/usr/local/bin/typeon-server run
Restart=on-failure
RestartSec=5

Environment=TYPEON_SERVER_DIR=/var/lib/typeon-server
# Tor is always on: the server is reachable only at its own .onion address (the
# listener is on 127.0.0.1). No port forwarding, domain or TLS is needed.
Environment=TYPEON_SERVER_NAME=Typeon
# Total disk budget in bytes. Defaults to 16 GiB if unset; set it to suit your disk.
#Environment=TYPEON_SERVER_BUDGET_BYTES=17179869184

# The server writes only to its own data directory. The database holds the libp2p key
# and the join token, so the files are readable by the owner only.
UMask=0077
StateDirectory=typeon-server
StateDirectoryMode=0700
ReadWritePaths=/var/lib/typeon-server
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
# AF_NETLINK: needed to watch network interface changes (libp2p if-watch).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
